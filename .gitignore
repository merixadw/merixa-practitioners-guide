# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ingest caches (regenerate with npm run ingest)
/content/raw-cache/
/content/corpus/
/content/tmp/
/content/enrich-drafts/
/content/extract-report.json
/content/ingest-report.json
/content/enrich-report.json

# wrangler
.wrangler/
.dev.vars

# Capacitor
/ios/App/Pods/
/ios/App/public/
/android/
*.xcuserdata/

# Progressive corpus (regenerate: npm run library:seamless)
/public/corpus/
/content/catalog.json
DerivedData/

# Large regenerable library index (npm run library:seamless / rebuild-index)
/content/index.json
/content/corpus-quarantine/

# Pipeline backups & run noise (regenerable)
/content/pipeline/backups/
/content/pipeline/index-backup-*.json
/content/pipeline/*.log
/content/pipeline/tmp-*
